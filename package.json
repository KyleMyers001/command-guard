{
  "name": "command-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Safety guard for Pi tool calls",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "command-guard.json",
    "dangerous-patterns.txt",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/command-guard.ts"
    ]
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='extensions/**/*.ts' tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
